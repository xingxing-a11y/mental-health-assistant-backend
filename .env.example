# ==============================================================================
# MindHarbor 后端 · 环境变量样例
# ------------------------------------------------------------------------------
# 用法：复制为 .env 后填写真实值。
#     cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交；本文件本身可以提交。
#
# 本文件与 src/main/resources/application.yml 逐项对应：yml 里每个
# `${VAR:默认值}` 占位符都能被这里的环境变量覆盖，未设置的项回落到默认值。
# 反过来说，改行为优先改这里的值，不必改 yml、更不必改 Java 代码。
#
# 注意：本文件供 docker compose（env_file 段）与 IDE 运行配置直接读取，
#       不要在 shell 里 source —— DB_URL 含 ? 与 &，会被 shell 当语法解释。
# ==============================================================================


# ------------------------------------------------------------------------------
# 数据库（必填：URL 有默认值，但账号密码必须提供）
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/mindharbor?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password


# ------------------------------------------------------------------------------
# Redis（可选，缺省连本机 6379）
# Redis 只存可重建的缓存，MySQL 始终是唯一主库；连不上会快速失败并回退 MySQL，
# 因此这项配错不会导致数据错误，只会失去缓存加速。
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2s


# ------------------------------------------------------------------------------
# 认证与 Cookie
# JWT_SECRET 必填：至少 32 字节随机串，泄漏等于所有人可伪造登录态。
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRATION_SECONDS=7200
# 线上走 HTTPS 时必须改成 true，否则 Cookie 不会带 Secure 属性。
COOKIE_SECURE=false


# ------------------------------------------------------------------------------
# AI 模型（必填，否则对话与知识库功能不可用）
# 需要同时提供「对话模型」与「Embedding 模型」两个模型名。
# ------------------------------------------------------------------------------
AI_BASE_URL=https://api.example.com
AI_API_KEY=replace_with_your_ai_api_key
AI_MODEL=replace_with_supported_chat_model
AI_EMBEDDING_MODEL=replace_with_supported_embedding_model
AI_MAX_TOKENS=2048
# 保持 1：失败不重试，避免一次请求叠加多轮等待延迟。
AI_RETRY_MAX_ATTEMPTS=1


# ------------------------------------------------------------------------------
# Chroma 向量库（可选）
# 未就绪时知识库检索降级为空，不影响登录与对话。
# ⚠️ CHROMA_HOST 必须带协议，Spring AI 会把它直接当 URI 使用。
# ------------------------------------------------------------------------------
CHROMA_HOST=http://localhost
CHROMA_PORT=8000
CHROMA_KEY_TOKEN=
CHROMA_COLLECTION=mental-health-knowledge


# ------------------------------------------------------------------------------
# 文件存储（头像）
# STORAGE_TYPE 决定启用下面哪一组配置，只接受 local / oss；
# 写成其它值、或选了 oss 但参数不全，都会在「启动时」直接报错并列出缺哪几项。
#   local —— 写本地磁盘，用 AVATAR_UPLOAD_DIR
#   oss   —— 写阿里云 OSS，用下面 4 项；bucket 保持私有，头像由后端代理读取
# 两种存储对外 URL 完全一致，切换不影响前端与数据库。
# ⚠️ application.yml 里 STORAGE_TYPE 的默认值是 oss 而非 local，
#    所以本地开发建议显式写成本例中的 local。
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
# 相对「进程工作目录」解析，不同启动方式解析出的绝对路径不同。
# 容器部署应写成绝对路径并挂卷，否则容器一重建头像全丢。
AVATAR_UPLOAD_DIR=./uploads/avatars
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_KEY_PREFIX=avatars


# ------------------------------------------------------------------------------
# 会话导出 PDF
# ------------------------------------------------------------------------------
# 中文字体文件绝对路径。留空不阻断启动，只是导出的中文会变成乱码；
# 容器内部需要能读到该字体文件。
EXPORT_PDF_FONT_PATH=
# 导出是重资源操作，并发超限直接返回 429；小内存机器建议保持 2。
EXPORT_PDF_MAX_CONCURRENT=2
EXPORT_PDF_ACQUIRE_TIMEOUT_SECONDS=2


# ------------------------------------------------------------------------------
# 定时清理任务（两个任务各自独立开关，共用一个调度线程池）
# ⚠️ cron 是三级取值：环境变量 > application.yml > 注解内兜底值。
#    平时生效的是 application.yml，在这里设置会覆盖它。
# ------------------------------------------------------------------------------
JOB_SESSION_CLEANUP_ENABLED=true
JOB_SESSION_CLEANUP_CRON=0 0 3 * * *
# 只对把消息保留期设为「30 天」的用户生效
JOB_SESSION_RETENTION_DAYS=30
JOB_SESSION_CLEANUP_BATCH_SIZE=200

JOB_NOTIFICATION_CLEANUP_ENABLED=true
JOB_NOTIFICATION_CLEANUP_CRON=30 0 3 * * *
JOB_NOTIFICATION_RETENTION_DAYS=180
JOB_NOTIFICATION_CLEANUP_BATCH_SIZE=200

# 调度线程池大小。至少 2，保证两个任务互不阻塞。
TASK_SCHEDULING_POOL_SIZE=2


# ------------------------------------------------------------------------------
# 缓存 TTL（单位：秒）
# 抖动（jitter）用于打散过期时刻，避免大批键同时失效后集中回源。
# 只有文章详情会写「不存在」的空缓存，因此 missing-* 仅出现在 article 下。
# ------------------------------------------------------------------------------
CACHE_ARTICLE_TTL_SECONDS=3600
CACHE_ARTICLE_JITTER_SECONDS=600
CACHE_ARTICLE_MISSING_TTL_SECONDS=300
CACHE_ARTICLE_MISSING_JITTER_SECONDS=60
CACHE_ANNOUNCEMENT_TTL_SECONDS=3600
CACHE_ANNOUNCEMENT_JITTER_SECONDS=600
CACHE_SENSITIVE_WORD_TTL_SECONDS=1200
CACHE_SENSITIVE_WORD_JITTER_SECONDS=300
# 缓存重建时单飞锁的最长等待时间（毫秒），超时后由当前请求直接回源
CACHE_REBUILD_LOCK_WAIT_MILLIS=100


# ------------------------------------------------------------------------------
# 知识库文档分块（单位：字符）
# ------------------------------------------------------------------------------
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=100


# ------------------------------------------------------------------------------
# 其它
# ------------------------------------------------------------------------------
APP_VERSION=1.0.0
# Tomcat 最大工作线程数。仅在不使用 docker-compose 时生效：
# compose 里已显式钉为 50 以压小内存占用，优先级高于本文件。
SERVER_TOMCAT_THREADS_MAX=200
