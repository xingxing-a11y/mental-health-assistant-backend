DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
JPA_DDL_AUTO=validate

# Redis 只保存可重建缓存，MySQL 仍是唯一主库；本机默认 redis://localhost:6379/0，无密码。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2s

AI_BASE_URL=https://api.example.com
AI_API_KEY=replace_with_your_ai_api_key
AI_MODEL=replace_with_supported_chat_model
AI_EMBEDDING_MODEL=replace_with_supported_embedding_model
AI_MAX_TOKENS=512
AI_RETRY_MAX_ATTEMPTS=1

JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRATION_SECONDS=7200
COOKIE_SECURE=false

CHROMA_HOST=http://localhost
CHROMA_PORT=8000
CHROMA_KEY_TOKEN=
CHROMA_COLLECTION=mental-health-knowledge
